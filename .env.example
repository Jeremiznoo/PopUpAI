# PopUpAI never reads API keys from the environment at runtime: keys live in
# the operating system's secret store (Secret Service / KWallet on Linux).
#
# These variables exist ONLY for opt-in live provider tests
# (cargo test -- --ignored live). Copy this file to .env (git-ignored), fill in
# values locally, and never commit them.
POPUPAI_TEST_OPENAI_API_KEY=
POPUPAI_TEST_ANTHROPIC_API_KEY=
POPUPAI_TEST_GEMINI_API_KEY=
POPUPAI_TEST_OLLAMA_ENDPOINT=http://127.0.0.1:11434
